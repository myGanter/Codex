<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>CodexCQRS.AspNet</Title>
    <Authors>myGanter</Authors>
    <Description>Lightweight CQRS engine with decorators and pipeline</Description>
    <RepositoryUrl>https://github.com/myGanter/Codex</RepositoryUrl>
    <PackageTags>cqrs;decorators;pipelines;lite;dotnet;asp-net;</PackageTags>
	<AssemblyVersion>1.0.1.0</AssemblyVersion>
	<FileVersion>$(AssemblyVersion)</FileVersion>
	<Version>$(AssemblyVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexCQRS\CodexCQRS.csproj" />
  </ItemGroup>

</Project>
